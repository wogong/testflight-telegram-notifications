# TestFlight public beta join link, e.g. https://testflight.apple.com/join/XXXXXXXX
TF_URL=https://testflight.apple.com/join/XXXXXXXX

# Telegram bot token from @BotFather
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstUVwxyz

# Chat ID to send to (your user id, or a group/channel id).
# Get yours by messaging the bot then visiting:
#   https://api.telegram.org/bot<TG_BOT_TOKEN>/getUpdates
TG_CHAT_ID=123456789

# Seconds between checks when running with --loop (default 300)
CHECK_INTERVAL=300

# HTTP request timeout in seconds (default 20)
HTTP_TIMEOUT=20
